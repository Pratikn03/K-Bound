\subsection{The budget audit: falsifiable, never verifiable}\label{sec:audit}

\begin{lemma}[Label-free identification of the drift, up to the bit]\label{lem:gamma-id}
Under H, the calibration drift of \S\ref{sec:bsfrontier} satisfies
$\gamma=\bar a_a-\tfrac12-M=b_a/2-M$. Hence, given the evidence law,
$\gamma\in\{+|b_a|/2-M,\,-|b_a|/2-M\}$: the unobservable budgeted quantity is
\emph{point-identified up to the bit}, with $M$ observable and $|b_a|$ given by
Theorem~\ref{thm:onebit-id}.
\end{lemma}

\begin{theorem}[Bit-robust budget falsification]\label{thm:audit}
From $m$ samples on $D$ build $\hat M$ with an empirical-Bernstein radius
$r^{(M)}_m(\alpha/2)$ and $\hat b_a$ from agreement estimates with the product-ratio
radius $r^{(b)}_m(\alpha/2)$ of Lemma~\ref{lem:prod-ratio}; set
$r_m=r^{(M)}_m+\tfrac12 r^{(b)}_m$ and
\[
  \texttt{reject } \big(|\gamma|\le\beta\big)
  \iff
  \min\Big(\big|{+}\tfrac{|\hat b_a|}{2}-\hat M\big|,\;
           \big|{-}\tfrac{|\hat b_a|}{2}-\hat M\big|\Big) \;>\; \beta+r_m .
\]
Then (soundness) if the budget truly holds the audit rejects with probability $\le\alpha$;
(power) if $\min_{\mathrm{flip}}|\gamma|>\beta+2r_m$ it rejects with probability
$\ge1-\alpha$. The $\min$ over flips is what makes soundness hold for the unknown true
bit.
\end{theorem}

\begin{lemma}[Product-ratio perturbation]\label{lem:prod-ratio}
If all $|\hat c-c|\le e_c\le c_{\min}/2$ entrywise with $|c|\in[c_{\min},1]$, then
$|\hat b_i^2-b_i^2|\le C_2 e_c$ with $C_2=(4c_{\min}+2)/c_{\min}^2$, and
$|\hat b_i-b_i|\le C_2e_c/\big(2\sqrt{b_{\min}^2-C_2e_c}\big)$ when $C_2e_c<b_{\min}^2$.
\end{lemma}

