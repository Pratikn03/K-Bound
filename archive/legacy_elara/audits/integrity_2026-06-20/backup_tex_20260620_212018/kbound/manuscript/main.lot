\contentsline {table}{\numberline {7.9}{\ignorespaces Regression covariate-shift experiment: MSE and \textsc {KGA}\ decision distribution. Source: \texttt {regression\_covariate.json}. Lower MSE is better; benefit $B = \text {MSE}(f_0) - \text {MSE}(f_a)$.}}{91}{table.7.9}%
\contentsline {table}{\numberline {7.10}{\ignorespaces Cross-experiment regret-to-oracle synthesis. All figures from the named JSON files; the ``vs always-freeze'' column expresses always-freeze's regret for comparison.}}{93}{table.7.10}%
