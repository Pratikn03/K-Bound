\contentsline {table}{\numberline {7.5}{\ignorespaces Multi-seed statistics (8 seeds, mixed regime). Values are mean $\pm $ std. Source: \texttt {rigor\_multiseed.json}, field \texttt {mean\_std}.}}{87}{table.7.5}%
\contentsline {table}{\numberline {7.6}{\ignorespaces Evidence-drop ablation: regret and false-adapt rate when each $Z$ feature is removed. Source: \texttt {ablations.json}, field \texttt {evidence\_drop}. Baseline (all features): regret $0.0365$, false-adapt $0.065$. The most important feature is \texttt {disagree}; removing it raises regret from $0.0365$ to $0.0940$ ($2.6\times $) and false-adapt from $0.065$ to $0.250$.}}{88}{table.7.6}%
\contentsline {table}{\numberline {7.7}{\ignorespaces $\alpha $ sweep: coverage and false-adapt rate at four conformal levels. Source: \texttt {ablations.json}, field \texttt {alpha\_sweep}.}}{89}{table.7.7}%
