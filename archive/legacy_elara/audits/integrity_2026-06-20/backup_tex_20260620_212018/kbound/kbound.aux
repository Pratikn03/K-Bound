\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {VII-A}0e}Fourth natural-shift track: Office-Home --- a \emph  {covariate} shift where detectability and mixedness \emph  {anti-correlate}.}{12}{paragraph.7.1.0.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces \textbf  {Natural hospital shift (WILDS Camelyon17), 4 seeds.} DenseNet-121 trained on source hospitals ($4$ epochs/seed), evaluated on the held-out hospital ($85{,}054$-patch OOD test; $\sim \!94\%$ patch subset, storage-limited extraction). Adaptation helps on \emph  {every} seed (mean benefit Tent $+0.031$, EATA $+0.050$, all four seeds positive), so always-adapt is the oracle (regret $0$). \textsc  {KGA} correctly leans toward adapting and beats always-freeze, but its finite-sample ($n{=}4$) caution costs $\approx \!0.02$ regret versus always-adapt---it does \emph  {not} beat both here. This is the honest benign-regime behaviour: with no detectable harm to avoid, the certificate is insurance with a small cost, not a win (contrast the harmful-cell regimes of Table~\ref {tab:decisive}).}}{13}{table.9}\protected@file@percent }
\newlabel{tab:camelyon}{{IX}{13}{\textbf {Natural hospital shift (WILDS Camelyon17), 4 seeds.} DenseNet-121 trained on source hospitals ($4$ epochs/seed), evaluated on the held-out hospital ($85{,}054$-patch OOD test; $\sim \!94\%$ patch subset, storage-limited extraction). Adaptation helps on \emph {every} seed (mean benefit Tent $+0.031$, EATA $+0.050$, all four seeds positive), so always-adapt is the oracle (regret $0$). \textsc {KGA} correctly leans toward adapting and beats always-freeze, but its finite-sample ($n{=}4$) caution costs $\approx \!0.02$ regret versus always-adapt---it does \emph {not} beat both here. This is the honest benign-regime behaviour: with no detectable harm to avoid, the certificate is insurance with a small cost, not a win (contrast the harmful-cell regimes of Table~\ref {tab:decisive})}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {X}{\ignorespaces \textbf  {Second natural shift (CIFAR-10.1 v6, ResNet-18), $24$ stream conditions per method, single quick pass ($\alpha {=}0.1$).} CIFAR-10.1 is $\sim $2{,}000 genuinely new test photographs collected by the original CIFAR-10 protocol---a \emph  {real}, low-margin distribution shift (frozen accuracy $0.771$). Per-condition benefits are small (mean $B$ between $-0.015$ and $+0.001$), so most evidence falls inside the abstain band: \textsc  {KGA} abstains on $71$--$92\%$ of conditions and makes \emph  {zero} false adapts (SAR adapt-precision $1.0$). For Tent and EATA---harmful in $58\%$/$46\%$ of conditions---\textsc  {KGA} routes to freezing and ties the better trivial policy while always-adapt pays up to $7\times $ more regret; for SAR it strictly (if narrowly) beats both policies and is Pareto-dominant for harmful fractions $p\gtrsim 0.1$. The displayed row is a single quick pass; a $5$-seed pooled re-run (seeds $0$--$4$, $24$ conditions per seed, \texttt  {cifar101\_multiseed\_v1/pooled\_summary.json}) confirms the regime ordering and the small-regret regime: pooled harmful-condition rate $0.675{\pm }0.017$ (Tent) / $0.500{\pm }0.059$ (EATA) / $0.050{\pm }0.031$ (SAR) with \textsc  {KGA} regret-to-oracle $0.0024{\pm }0.0007$ / $0.0035{\pm }0.0011$ / $0.0045{\pm }0.0014$ respectively, so the abstain-dominated, near-tie conclusion is stable across seeds.}}{13}{table.10}\protected@file@percent }
\newlabel{tab:cifar101}{{X}{13}{\textbf {Second natural shift (CIFAR-10.1 v6, ResNet-18), $24$ stream conditions per method, single quick pass ($\alpha {=}0.1$).} CIFAR-10.1 is $\sim $2{,}000 genuinely new test photographs collected by the original CIFAR-10 protocol---a \emph {real}, low-margin distribution shift (frozen accuracy $0.771$). Per-condition benefits are small (mean $B$ between $-0.015$ and $+0.001$), so most evidence falls inside the abstain band: \textsc {KGA} abstains on $71$--$92\%$ of conditions and makes \emph {zero} false adapts (SAR adapt-precision $1.0$). For Tent and EATA---harmful in $58\%$/$46\%$ of conditions---\textsc {KGA} routes to freezing and ties the better trivial policy while always-adapt pays up to $7\times $ more regret; for SAR it strictly (if narrowly) beats both policies and is Pareto-dominant for harmful fractions $p\gtrsim 0.1$. The displayed row is a single quick pass; a $5$-seed pooled re-run (seeds $0$--$4$, $24$ conditions per seed, \texttt {cifar101\_multiseed\_v1/pooled\_summary.json}) confirms the regime ordering and the small-regret regime: pooled harmful-condition rate $0.675{\pm }0.017$ (Tent) / $0.500{\pm }0.059$ (EATA) / $0.050{\pm }0.031$ (SAR) with \textsc {KGA} regret-to-oracle $0.0024{\pm }0.0007$ / $0.0035{\pm }0.0011$ / $0.0045{\pm }0.0014$ respectively, so the abstain-dominated, near-tie conclusion is stable across seeds}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XI}{\ignorespaces \textbf  {ImageNet-R: a real natural shift in the \emph  {unknowable} regime.} Mixed harm ($13.9\%$), weak detectability (AUC $0.662$), low margins ($\bar  B{=}{+}0.017$): the certificate abstains everywhere, as Corollary~\ref {cor:forced-abstain} mandates, and the CEI diagnostic correctly refuses the agreement route for co-trained candidates ($\tau \gg \tau ^\star $ on all $48$ conditions). Single-seed light protocol; the three candidates share one backbone, which is exactly the CEI-violating setting the diagnostic exists to catch.}}{13}{table.11}\protected@file@percent }
\newlabel{tab:imagenetr}{{XI}{13}{\textbf {ImageNet-R: a real natural shift in the \emph {unknowable} regime.} Mixed harm ($13.9\%$), weak detectability (AUC $0.662$), low margins ($\bar B{=}{+}0.017$): the certificate abstains everywhere, as Corollary~\ref {cor:forced-abstain} mandates, and the CEI diagnostic correctly refuses the agreement route for co-trained candidates ($\tau \gg \tau ^\star $ on all $48$ conditions). Single-seed light protocol; the three candidates share one backbone, which is exactly the CEI-violating setting the diagnostic exists to catch}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XII}{\ignorespaces \textbf  {Office-Home: a covariate shift where detectability and mixedness anti-correlate.} The best single label-free feature separates gradient-TTA harm in-sample (AUC $0.79$--$0.81$, $n{\approx }432$), but the source-calibrated certificate \emph  {anti-transfers} (transfer-AUC $0.33$/$0.49$) and the only \emph  {mixed} domain (Product) has label-free-\emph  {undetectable} harm. The deployed adapter is net-helpful, so \textsc  {KGA} ties always-freeze, loses to always-adapt, makes \emph  {zero} false-adapts, and does not beat both on val or held-out test. $2$ seeds, $14$ candidates (incl.\ two inference-only priors), $n_{\mathrm  {eval}}{=}320$.}}{14}{table.12}\protected@file@percent }
\newlabel{tab:officehome}{{XII}{14}{\textbf {Office-Home: a covariate shift where detectability and mixedness anti-correlate.} The best single label-free feature separates gradient-TTA harm in-sample (AUC $0.79$--$0.81$, $n{\approx }432$), but the source-calibrated certificate \emph {anti-transfers} (transfer-AUC $0.33$/$0.49$) and the only \emph {mixed} domain (Product) has label-free-\emph {undetectable} harm. The deployed adapter is net-helpful, so \textsc {KGA} ties always-freeze, loses to always-adapt, makes \emph {zero} false-adapts, and does not beat both on val or held-out test. $2$ seeds, $14$ candidates (incl.\ two inference-only priors), $n_{\mathrm {eval}}{=}320$}{table.12}{}}
