\@writefile{lot}{\contentsline {table}{\numberline {XXIV}{\ignorespaces \textbf  {ImageNet-C, mechanism-faithful SAR re-implementation ($36$ cells/candidate, ResNet-50, $\alpha {=}0.1$).} Same noise grid, protocol, and metrics as Table~\ref {tab:imagenetc}; SAR re-implemented to the reference mechanism (SAM, recovery reset, EMA) at the learning rate shared across candidates. The harmful regime survives the faithful re-implementation (SAR harmful on $44\%$ of cells, mean benefit $-0.086$): always-adapt collapses to $0.319$ while \textsc  {KGA} certifies-or-abstains to $0.409$, \emph  {beating both} trivial policies (regret $0.0229$ vs $0.1124$/$0.0267$); Tent/EATA stay benign and \textsc  {KGA} ties always-adapt. Oracle accuracy $0.455$/$0.444$/$0.432$. \emph  {Caveat:} matched/shared LR; SAR's official lr $2.5{\times }10^{-4}$, \texttt  {layer4}-frozen schedule not yet run.}}{27}{table.24}\protected@file@percent }
\newlabel{tab:imagenetc-faithful}{{XXIV}{27}{\textbf {ImageNet-C, mechanism-faithful SAR re-implementation ($36$ cells/candidate, ResNet-50, $\alpha {=}0.1$).} Same noise grid, protocol, and metrics as Table~\ref {tab:imagenetc}; SAR re-implemented to the reference mechanism (SAM, recovery reset, EMA) at the learning rate shared across candidates. The harmful regime survives the faithful re-implementation (SAR harmful on $44\%$ of cells, mean benefit $-0.086$): always-adapt collapses to $0.319$ while \textsc {KGA} certifies-or-abstains to $0.409$, \emph {beating both} trivial policies (regret $0.0229$ vs $0.1124$/$0.0267$); Tent/EATA stay benign and \textsc {KGA} ties always-adapt. Oracle accuracy $0.455$/$0.444$/$0.432$. \emph {Caveat:} matched/shared LR; SAR's official lr $2.5{\times }10^{-4}$, \texttt {layer4}-frozen schedule not yet run}{table.24}{}}
