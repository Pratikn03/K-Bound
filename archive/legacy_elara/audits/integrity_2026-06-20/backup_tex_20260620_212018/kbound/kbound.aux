\@writefile{lot}{\contentsline {table}{\numberline {XXII}{\ignorespaces \textbf  {ImageNet scale (ImageNet-C, ResNet-50), complete: $36$ cells, $4000$ images/cell.} Full noise grid (gaussian/shot/impulse $\times $ severities $\{1,3,5\}$ $\times $ batch/aggressiveness regimes), same adapt/freeze/abstain protocol and metrics as Table~\ref {tab:decisive}. The outcome splits by how robust each method is on this benchmark. \emph  {Tent} and \emph  {EATA} are robust here: adaptation helps (harmful in only $8\%$/$3\%$ of cells), so always-adapt is near-optimal and \textsc  {KGA} correctly adapts---tying always-adapt to within $0.004$ and beating always-freeze, the honest ``does-no-harm'' outcome. \emph  {SAR} collapses on $31\%$ of cells (mean benefit $-0.033$): always-adapt falls to $0.377$ while \textsc  {KGA} certifies-or-abstains to $0.429$, \emph  {beating both} trivial policies and approaching the oracle ($0.437$). Across all three methods \textsc  {KGA} never underperforms the better trivial policy, and strictly wins on the one method that is harmful. This first ResNet-50 SAR port is corroborated by a mechanism-faithful re-run (Table~\ref {tab:imagenetc-faithful}).}}{26}{table.22}\protected@file@percent }
\newlabel{tab:imagenetc}{{XXII}{26}{\textbf {ImageNet scale (ImageNet-C, ResNet-50), complete: $36$ cells, $4000$ images/cell.} Full noise grid (gaussian/shot/impulse $\times $ severities $\{1,3,5\}$ $\times $ batch/aggressiveness regimes), same adapt/freeze/abstain protocol and metrics as Table~\ref {tab:decisive}. The outcome splits by how robust each method is on this benchmark. \emph {Tent} and \emph {EATA} are robust here: adaptation helps (harmful in only $8\%$/$3\%$ of cells), so always-adapt is near-optimal and \textsc {KGA} correctly adapts---tying always-adapt to within $0.004$ and beating always-freeze, the honest ``does-no-harm'' outcome. \emph {SAR} collapses on $31\%$ of cells (mean benefit $-0.033$): always-adapt falls to $0.377$ while \textsc {KGA} certifies-or-abstains to $0.429$, \emph {beating both} trivial policies and approaching the oracle ($0.437$). Across all three methods \textsc {KGA} never underperforms the better trivial policy, and strictly wins on the one method that is harmful. This first ResNet-50 SAR port is corroborated by a mechanism-faithful re-run (Table~\ref {tab:imagenetc-faithful})}{table.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XXIII}{\ignorespaces \textbf  {Decision baselines executed on the logged ImageNet-C conditions} (reference-parity SAR; $36$ cells/candidate; harmful base rates $6\%/3\%/44\%$ for Tent/EATA/SAR). ``LOO-tuned'' rules choose their threshold leave-one-out on the remaining conditions --- the same calibration information \textsc  {KGA} uses; ``hindsight'' picks feature, sign, and threshold on the evaluation conditions themselves (not realizable). \textsc  {KGA} is the only rule with zero false adapts on all three candidates; on the harmful candidate \emph  {every realizable single-statistic rule loses} --- the best (EATA-filter, $0.0369$) pays $1.6\times $ \textsc  {KGA}'s $0.0229$ and is still worse than plain always-freeze, because no single statistic cleanly separates SAR's harmful cells. The committal benefit model (row~8) shows the multivariate evidence model carries the decision power ($0.0010$ on SAR) but lacks validity --- it adapts into harmful cells with no false-adapt control --- so the abstain band's $\approx 0.02$ regret on SAR is the measured price of the guarantee, matching Thm.~\ref {thm:frontier}(iv). \emph  {Reproducibility note:} the canonical KGA pipeline and this post-hoc re-derivation agree exactly on SAR; the leave-one-out benefit model is mildly sensitive to condition order, so the Tent/EATA \textsc  {KGA} regrets differ from Table~\ref {tab:imagenetc} by $\le 0.004$.}}{26}{table.23}\protected@file@percent }
\newlabel{tab:decision-baselines}{{XXIII}{26}{\textbf {Decision baselines executed on the logged ImageNet-C conditions} (reference-parity SAR; $36$ cells/candidate; harmful base rates $6\%/3\%/44\%$ for Tent/EATA/SAR). ``LOO-tuned'' rules choose their threshold leave-one-out on the remaining conditions --- the same calibration information \textsc {KGA} uses; ``hindsight'' picks feature, sign, and threshold on the evaluation conditions themselves (not realizable). \textsc {KGA} is the only rule with zero false adapts on all three candidates; on the harmful candidate \emph {every realizable single-statistic rule loses} --- the best (EATA-filter, $0.0369$) pays $1.6\times $ \textsc {KGA}'s $0.0229$ and is still worse than plain always-freeze, because no single statistic cleanly separates SAR's harmful cells. The committal benefit model (row~8) shows the multivariate evidence model carries the decision power ($0.0010$ on SAR) but lacks validity --- it adapts into harmful cells with no false-adapt control --- so the abstain band's $\approx 0.02$ regret on SAR is the measured price of the guarantee, matching Thm.~\ref {thm:frontier}(iv). \emph {Reproducibility note:} the canonical KGA pipeline and this post-hoc re-derivation agree exactly on SAR; the leave-one-out benefit model is mildly sensitive to condition order, so the Tent/EATA \textsc {KGA} regrets differ from Table~\ref {tab:imagenetc} by $\le 0.004$}{table.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {C}Validation figures for Theorems~\ref {thm:conj1-dichotomy} and~\ref {thm:ev-rate}}{26}{subsection.Appendix.A.3}\protected@file@percent }
