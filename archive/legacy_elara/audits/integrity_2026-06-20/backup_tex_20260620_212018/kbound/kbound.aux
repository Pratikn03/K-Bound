\@writefile{lot}{\contentsline {table}{\numberline {XXI}{\ignorespaces \textbf  {RxRx1: a real natural shift in the \emph  {harmful-and-detectable} regime ($9{+}$ protocol).} At $1{,}139$-class scale adaptation is harmful-dominated ($81.5\%$ of records $B<0$, $\bar  B{=}{-}0.063$) and the harm is label-free detectable (AUC $0.78$--$0.84$). Always-adapt is catastrophic---SAR-online collapses to $0.024$ and even the best candidate ($0.276$) trails the frozen model ($0.283$)---so freezing is the oracle policy, and the single-candidate certificate freezes/abstains on all $360$ conditions with \emph  {zero} false adapts, matching it. The multi-candidate agreement route abstains everywhere ($\hat  \tau \gg \tau ^\star $ on all $360$): the six candidates share one backbone, the CEI-violating setting the diagnostic catches. Verdict replicates across all $3$ official WILDS base-model seeds; complete $360/360$, commodity GPU ($16$\,GB).}}{24}{table.21}\protected@file@percent }
\newlabel{tab:rxrx1}{{XXI}{24}{\textbf {RxRx1: a real natural shift in the \emph {harmful-and-detectable} regime ($9{+}$ protocol).} At $1{,}139$-class scale adaptation is harmful-dominated ($81.5\%$ of records $B<0$, $\bar B{=}{-}0.063$) and the harm is label-free detectable (AUC $0.78$--$0.84$). Always-adapt is catastrophic---SAR-online collapses to $0.024$ and even the best candidate ($0.276$) trails the frozen model ($0.283$)---so freezing is the oracle policy, and the single-candidate certificate freezes/abstains on all $360$ conditions with \emph {zero} false adapts, matching it. The multi-candidate agreement route abstains everywhere ($\hat \tau \gg \tau ^\star $ on all $360$): the six candidates share one backbone, the CEI-violating setting the diagnostic catches. Verdict replicates across all $3$ official WILDS base-model seeds; complete $360/360$, commodity GPU ($16$\,GB)}{table.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {ImageNet-C (noise, ResNet-50): \textsc  {KGA} is Pareto-optimal for the harmful candidate SAR.} Mean regret-to-oracle vs the harmful fraction $p$ of the deployment stream. \textsc  {KGA} (green) ties always-adapt at $p{=}0$ and strictly beats \emph  {both} trivial policies for $p\gtrsim 0.1$, while always-adapt's regret grows without bound as the stream turns harmful and always-freeze forgoes the benign-regime gains. ImageNet-scale counterpart of Fig.~\ref {fig:decisive}; the visual form of the SAR row of Table~\ref {tab:imagenetc}. Produced by ; data.}}{25}{figure.9}\protected@file@percent }
\newlabel{fig:imagenetc}{{9}{25}{\textbf {ImageNet-C (noise, ResNet-50): \textsc {KGA} is Pareto-optimal for the harmful candidate SAR.} Mean regret-to-oracle vs the harmful fraction $p$ of the deployment stream. \textsc {KGA} (green) ties always-adapt at $p{=}0$ and strictly beats \emph {both} trivial policies for $p\gtrsim 0.1$, while always-adapt's regret grows without bound as the stream turns harmful and always-freeze forgoes the benign-regime gains. ImageNet-scale counterpart of Fig.~\ref {fig:decisive}; the visual form of the SAR row of Table~\ref {tab:imagenetc}. Produced by ; data}{figure.9}{}}
