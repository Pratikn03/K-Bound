\newlabel{tab:c10c}{{6}{15}{CIFAR-10-C, 13 official corruptions $\times $ 5 severities, online TTA. Adaptation is overwhelmingly helpful per-corruption (false-adapt $0.015$); \textsc {KGA} matches always-adapt at equal safety. This is the helpful-dominated control, not a collapse setting}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Per-window accuracy on the \emph  {harm-dominated} stream (pink = catastrophic ``trap'' windows). Continual Tent (always-adapt) accumulates damage through the long trap runs and \emph  {collapses}; \textsc  {KGA} freezes/abstains on traps and never collapses, staying near always-freeze while capturing gains elsewhere.}}{16}{figure.9}\protected@file@percent }
\newlabel{fig:online}{{9}{16}{Per-window accuracy on the \emph {harm-dominated} stream (pink = catastrophic ``trap'' windows). Continual Tent (always-adapt) accumulates damage through the long trap runs and \emph {collapses}; \textsc {KGA} freezes/abstains on traps and never collapses, staying near always-freeze while capturing gains elsewhere}{figure.9}{}}
