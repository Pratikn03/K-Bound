\newlabel{thm:imp}{{1}{5}{Non-identifiability; with witness}{theorem.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The knowability phase diagram.} Each test-time condition lands at a point set by the evidence separability between opposite-benefit worlds ($x$-axis; a total-variation/detectability proxy) and the benefit margin $|\Delta |$ ($y$-axis). \textsc  {KGA} commits (\textsc  {adapt}/\textsc  {freeze}) only outside the central \emph  {unknowable} wedge, where the certificate radius exceeds the estimated benefit ($\varepsilon >|\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \Delta $}\mathaccent "0362{\Delta }|$); inside it the worst-case-optimal action is \textsc  {abstain} (Theorem~\ref {thm:imp}). Benchmark points---the CIFAR-10-C stress grid (Tent/EATA/SAR), the controlled mixed regime, and the clean non-identifiability witness---are overlaid from their measured values.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:phase}{{1}{6}{\textbf {The knowability phase diagram.} Each test-time condition lands at a point set by the evidence separability between opposite-benefit worlds ($x$-axis; a total-variation/detectability proxy) and the benefit margin $|\Delta |$ ($y$-axis). \textsc {KGA} commits (\textsc {adapt}/\textsc {freeze}) only outside the central \emph {unknowable} wedge, where the certificate radius exceeds the estimated benefit ($\varepsilon >|\widehat \Delta |$); inside it the worst-case-optimal action is \textsc {abstain} (Theorem~\ref {thm:imp}). Benchmark points---the CIFAR-10-C stress grid (Tent/EATA/SAR), the controlled mixed regime, and the clean non-identifiability witness---are overlaid from their measured values}{figure.1}{}}
\newlabel{thm:imp-quant}{{2}{6}{Quantitative non-identifiability; Le Cam two-point lower bound}{theorem.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Theorem~\ref {thm:imp-quant}: the optimal committal rule's worst-case regret coincides with the Le Cam floor $\tfrac  {\delta }{2}(1-\mathrm  {TV})$ across the TV sweep; at $\mathrm  {TV}=0$ (the witness) it equals $\delta /2$. Produced by \texttt  {scripts/theory\_extensions\_validation.py}.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:lecam}{{2}{7}{Theorem~\ref {thm:imp-quant}: the optimal committal rule's worst-case regret coincides with the Le Cam floor $\tfrac {\delta }{2}(1-\TV )$ across the TV sweep; at $\TV =0$ (the witness) it equals $\delta /2$. Produced by \texttt {scripts/theory\_extensions\_validation.py}}{figure.2}{}}
