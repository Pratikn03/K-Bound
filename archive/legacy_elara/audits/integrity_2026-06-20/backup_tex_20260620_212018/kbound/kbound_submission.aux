\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {ImageNet scale (ImageNet-C, ResNet-50).} Noise corruptions (gaussian/shot/impulse $\times $ 5 severities; blur added once extracted), same adapt/freeze/abstain protocol and metrics as the CIFAR-10-C stress grid (Table~\ref {tab:decisive}). Tent cells are populated from the \emph  {completed} $n{=}8$-condition smoke run (\texttt  {experiments/kbound/results/imagenetc\_smoke/decisive\_tta\_results.json}): with only $8$ calibration conditions the leave-one-out estimator certifies nothing, so \textsc  {KGA} abstains throughout (coverage $0$), inherits the better trivial policy, and never adapts into harm --- Tent's worst cell collapses to $0.078$ accuracy while \textsc  {KGA} holds $0.414$. The full noise/blur grid ($\ge \!40$ conditions) and the EATA/SAR rows are pending and will replace these cells.}}{20}{table.9}\protected@file@percent }
\newlabel{tab:imagenetc}{{9}{20}{\textbf {ImageNet scale (ImageNet-C, ResNet-50).} Noise corruptions (gaussian/shot/impulse $\times $ 5 severities; blur added once extracted), same adapt/freeze/abstain protocol and metrics as the CIFAR-10-C stress grid (Table~\ref {tab:decisive}). Tent cells are populated from the \emph {completed} $n{=}8$-condition smoke run (\texttt {experiments/kbound/results/imagenetc\_smoke/decisive\_tta\_results.json}): with only $8$ calibration conditions the leave-one-out estimator certifies nothing, so \textsc {KGA} abstains throughout (coverage $0$), inherits the better trivial policy, and never adapts into harm --- Tent's worst cell collapses to $0.078$ accuracy while \textsc {KGA} holds $0.414$. The full noise/blur grid ($\ge \!40$ conditions) and the EATA/SAR rows are pending and will replace these cells}{table.9}{}}
