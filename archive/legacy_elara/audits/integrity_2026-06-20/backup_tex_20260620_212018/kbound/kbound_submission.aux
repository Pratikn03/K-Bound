\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces CIFAR-10-C stress grid, mixing-ratio Pareto: mean regret-to-oracle vs the harmful fraction $p$ of the deployment stream, per candidate (Tent/EATA/SAR). \textsc  {KGA} (green) stays on the Pareto front---tying always-adapt at $p{=}0$, strictly beating both trivial policies for $p\gtrsim p^\star $, and never collapsing like always-adapt or stalling like always-freeze.}}{18}{figure.11}\protected@file@percent }
\newlabel{fig:decisive}{{11}{18}{CIFAR-10-C stress grid, mixing-ratio Pareto: mean regret-to-oracle vs the harmful fraction $p$ of the deployment stream, per candidate (Tent/EATA/SAR). \textsc {KGA} (green) stays on the Pareto front---tying always-adapt at $p{=}0$, strictly beating both trivial policies for $p\gtrsim p^\star $, and never collapsing like always-adapt or stalling like always-freeze}{figure.11}{}}
\@writefile{toc}{\contentsline {paragraph}{Claim discipline (what we do and do not assert).}{18}{section*.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Natural hospital shift (WILDS Camelyon17), 4 seeds.} DenseNet-121 trained on source hospitals ($4$ epochs/seed), evaluated on the held-out hospital ($85{,}054$-patch OOD test; $\sim \!94\%$ patch subset, storage-limited extraction). Adaptation helps on \emph  {every} seed (mean benefit Tent $+0.031$, EATA $+0.050$, all four seeds positive), so always-adapt is the oracle (regret $0$). \textsc  {KGA} correctly leans toward adapting and beats always-freeze, but its finite-sample ($n{=}4$) caution costs $\approx \!0.02$ regret versus always-adapt---it does \emph  {not} beat both here. This is the honest benign-regime behaviour: with no detectable harm to avoid, the certificate is insurance with a small cost, not a win (contrast the harmful-cell regimes of Tables~\ref {tab:decisive} and~\ref {tab:imagenetc}). From \texttt  {experiments/kbound/results/wilds/wilds\_camelyon17\_kga.json}.}}{19}{table.8}\protected@file@percent }
\newlabel{tab:camelyon}{{8}{19}{\textbf {Natural hospital shift (WILDS Camelyon17), 4 seeds.} DenseNet-121 trained on source hospitals ($4$ epochs/seed), evaluated on the held-out hospital ($85{,}054$-patch OOD test; $\sim \!94\%$ patch subset, storage-limited extraction). Adaptation helps on \emph {every} seed (mean benefit Tent $+0.031$, EATA $+0.050$, all four seeds positive), so always-adapt is the oracle (regret $0$). \textsc {KGA} correctly leans toward adapting and beats always-freeze, but its finite-sample ($n{=}4$) caution costs $\approx \!0.02$ regret versus always-adapt---it does \emph {not} beat both here. This is the honest benign-regime behaviour: with no detectable harm to avoid, the certificate is insurance with a small cost, not a win (contrast the harmful-cell regimes of Tables~\ref {tab:decisive} and~\ref {tab:imagenetc}). From \texttt {experiments/kbound/results/wilds/wilds\_camelyon17\_kga.json}}{table.8}{}}
