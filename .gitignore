AETTA/dataset/
AETTA/**/*.npy
AETTA/**/*.npz
AETTA/**/*.pkl
AETTA/**/*.pt
AETTA/**/*.pth
AETTA/**/*.ckpt

# Temporary PDF renders / page-image dumps produced by the release runbook's
# visual-render check (the compiled release PDFs live under paper/ and are kept).
docs/research/kbound/**/_pdf_render_*/
